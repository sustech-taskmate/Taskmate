{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": "all"
  },
  "productName": "Taskmate",
  "mainBinaryName": "Taskmate",
  "version": "../package.json",
  "identifier": "cn.taskmate.edu",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "taskmate"
        ]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Taskmate",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "$APPDATA/**"
        ],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-eval'; connect-src ipc: http://ipc.localhost https:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
